# Supabase / Postgres for the « Questions » chat — copy to .env locally, or set the
# same names in the host's dashboard (Vercel / Render → Environment Variables).
# NEVER commit a filled-in .env, the secret key, or the database password to git.
#
# Public values (also in docs/assets/js/questions-config.js — safe to expose):
SUPABASE_URL=https://hggaeaqccvxjiwnevaui.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_JWKS_URL=https://hggaeaqccvxjiwnevaui.supabase.co/auth/v1/.well-known/jwks.json
#
# Private values — server-side only, from Supabase → Project Settings:
SUPABASE_SECRET_KEY=<your-secret-key-from-supabase>
#
# Direct Postgres connection (used by tools/questions_db.py via tools/lancer.py
# to apply supabase/questions.sql at startup on Render):
QUESTIONS_DATABASE_URL=postgresql://postgres:<DATABASE_PASSWORD>@db.hggaeaqccvxjiwnevaui.supabase.co:5432/postgres
# host=db.hggaeaqccvxjiwnevaui.supabase.co  port=5432  database=postgres  user=postgres
